<?xml version="1.0" encoding="utf-8"?><!-- Kartu bento screensaver: seulas lebih terang dari kartu utama. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0AFFFFFF"
                android:startColor="#1AFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
