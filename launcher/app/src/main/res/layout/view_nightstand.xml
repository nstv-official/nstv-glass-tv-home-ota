<?xml version="1.0" encoding="utf-8"?><!--
  Layar screensaver StandBy. Satu layout dipakai tiga gaya (digital, editorial, analog):
  yang berubah hanya tata letak dan ukuran, diatur dari Nightstand.java.
  Latar boleh hitam murni, wallpaper yang dikecilkan (kesan berkaca), atau aurora sesuai jam.
  Gaya bento memakai view_nightstand_bento.xml dengan id yang sama persis.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nightstandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Latar 1: wallpaper aktif, dikecilkan ekstrem sehingga terbaca sebagai kaca buram. -->
    <ImageView
        android:id="@+id/nightstandBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- Latar 2: cahaya aurora yang warnanya mengikuti jam. -->
    <View
        android:id="@+id/nightstandAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Keredupan total, supaya mode malam tetap nyaman di ruang gelap. -->
    <View
        android:id="@+id/nightstandScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/nightstandContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Kartu kaca di belakang tulisan; bisa dimatikan dari pengaturan. -->
        <LinearLayout
            android:id="@+id/nightstandCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nightstand_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="46dp"
            android:paddingTop="34dp"
            android:paddingEnd="46dp"
            android:paddingBottom="30dp">

            <!-- Jam analog (gaya ANALOG) -->
            <com.gathin.tvhome.AnalogDialView
                android:id="@+id/nightstandDial"
                android:layout_width="270dp"
                android:layout_height="270dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/nightstandClockRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/nightstandClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 400"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10"
                    android:textColor="#FFFFFFFF"
                    android:textSize="110sp" />

                <TextClock
                    android:id="@+id/nightstandAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="26dp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Garis rambut: hanya tampil pada gaya editorial. -->
            <View
                android:id="@+id/nightstandRule"
                android:layout_width="140dp"
                android:layout_height="1.5dp"
                android:layout_marginTop="14dp"
                android:background="#4DFFFFFF"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/nightstandDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 500"
                android:format12Hour="EEEE, d MMMM yyyy"
                android:format24Hour="EEEE, d MMMM yyyy"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:textColor="#E6FFFFFF"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/nightstandHijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 400"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:textColor="#D9E6E0D2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/nightstandWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 500"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/nightstandPrayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/pill_bg"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 500"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nightstandHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="Tekan tombol apa saja untuk kembali"
            android:textColor="#4DFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
