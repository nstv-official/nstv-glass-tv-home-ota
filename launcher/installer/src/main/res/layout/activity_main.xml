<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:maxWidth="640dp"
        android:layout_gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_update"
                android:tint="#FFFFFFFF"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glass TV Installer"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Installer Mudah Android TV dari Ponsel / Tablet"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_glass"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="v3.1.4"
                android:textColor="#FF90B8"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 1: Koneksi TV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 Koneksi Android TV (Wi-Fi)"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLocalIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP Ponsel Anda: Memeriksa..."
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etTvIp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="IP TV (mis.: 192.168.68.110)"
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:paddingHorizontal="14dp"
                    android:inputType="textUri"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etTvPort"
                    android:layout_width="75dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:text="5555"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:inputType="number" />
            </LinearLayout>

            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_glass"
                android:text="🔍 Pindai Android TV di Jaringan Wi-Fi"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Card 2: Aksi Pemasangan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Pasang Glass TV Home"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnInstall"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_accent"
                android:text="Pasang ke TV Sekarang"
                android:textColor="#0C0E14"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:progressTint="#FF90B8"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Masukkan IP TV atau tekan 'Pindai' untuk memulai."
                android:textColor="#B3FFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLaunch"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_glass"
                    android:text="▶️ Buka di TV"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/inter"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnWebServer"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_btn_glass"
                    android:text="🌐 Server Web TV"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/inter"
                    android:textAllCaps="false" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSetHome"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_glass"
                android:text="🏠 Ubah Tombol Home Remote (Set Default Launcher)"
                android:textColor="#38BDF8"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvWebUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF90B8"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Card 3: Panduan 3 Langkah -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 Cara Siapkan TV Anda (Cukup Sekali)"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1️⃣ Pada TV, masuk ke Settings > Device Preferences > About > tekan 'Android TV OS build' 7 kali berturut-turut untuk mengaktifkan Developer Options.\n\n2️⃣ Kembali ke Settings > Developer Options > aktifkan 'USB Debugging' dan 'Wireless Debugging' (jika ada).\n\n3️⃣ Pastikan ponsel dan TV terhubung pada Wi-Fi yang sama, lalu tekan 'Pasang Sekarang'."
                android:textColor="#99FFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Card 4: Traktir Kopi & Saran -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_glass"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_coffee"
                    android:tint="#FFFFFFFF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dukung Pengembang"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" @tv-home"
                    android:textColor="#FF90B8"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QRIS • GPN"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:layout_width="160dp"
                android:layout_height="200dp"
                android:src="@drawable/qr_support"
                android:scaleType="fitCenter"
                android:layout_marginBottom="10dp"
                android:contentDescription="QRIS @tv-home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pindai dengan kamera ponsel / aplikasi perbankan untuk mendukung pengembangan launcher."
                android:textColor="#99FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📧 Saran &amp; Masukan: officialnstv@gmail.com"
                android:textColor="#CCFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
